{
  "name": "my-app-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "streaming:clone" : "git clone https://github.com/EpicGames/PixelStreamingInfrastructure.git ../PixelStreamingInfrastructure",
    "streaming:install" : "cd ../PixelStreamingInfrastructure/Frontend && npm install",
    "streaming:build" : "cd ../PixelStreamingInfrastructure/Common && npm run build && cd ../Frontend/library && npm run build && cd ../ui-library && npm run build && cd ../implementations/typescript && npm install && npm run build",
    "streaming:build-prod" : "cd ../PixelStreamingInfrastructure/Common && npm run build && cd ../Frontend/library && npm run build && cd ../ui-library && npm run build && cd ../implementations/typescript && npm install && npm run build:prod",
    "setup" : "npm run streaming:clone && npm run streaming:install && npm run streaming:build",
    "setup-prod" : "npm run streaming:clone && npm run streaming:install && npm run streaming:build-prod",
    "streaming:server" : "cd ../PixelStreamingInfrastructure/Frontend/implementations/typescript && npm run serve",
    "streaming:server-prod" : "cd ../PixelStreamingInfrastructure/Frontend/implementations/typescript && npm run serve-prod",
    "dev": "concurrently  \"npm run start\" \"npm run streaming:server\"",  
    "prod" : "concurrently  \"npm run start\" \"npm run streaming:server-prod\"",
    "start-prod" : "npx expo start --no-dev --minify",
    "start": "npx expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "babel-preset-expo": "~54.0.10",
    "concurrently": "^10.0.4",
    "expo": "^54.0.0",
    "expo-audio": "~1.1.1",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-uuid": "^2.0.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "stream": "^0.0.3",
    "tailwind": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.3.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
